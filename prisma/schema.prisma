generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 🏢 NOVOS MODELOS PARA MULTI-TENANCY E SETORES
// ==========================================

model Empresa {
  id           String        @id @default(uuid())
  razaoSocial  String        @map("razao_social")
  cnpj         String        @unique
  tokenTotem   String        @unique @default(uuid()) @map("token_totem") // Hash usado para autenticar o tablet da portaria
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  
  filiais      Filial[]
  setores      Setor[]
  usuarios     Usuario[]
  batidas      BatidaPonto[]
  afastamentos Afastamento[]
  horarios     Horario[]

  @@map("empresas")
}

model Filial {
  id        String    @id @default(uuid())
  nome      String
  cnpj      String?   // Permite nulo caso herdem o CNPJ da matriz
  empresaId String    @map("empresa_id")
  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  
  setores   Setor[]
  usuarios  Usuario[]

  @@map("filiais")
}

model Setor {
  id        String        @id @default(uuid())
  nome      String        // Ex: "TI", "Recursos Humanos", "Logística"
  empresaId String        @map("empresa_id")
  empresa   Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  filialId  String        @map("filial_id")
  filial    Filial        @relation(fields: [filialId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  
  usuarios  Usuario[]
  batidas   BatidaPonto[]

  @@map("setores")
}

// ==========================================
// 🔄 MODELOS ATUALIZADOS COM HERANÇA MULTI-TENANT
// ==========================================

model Usuario {
  id               String         @id @default(uuid())
  nome             String
  cpf              String         @unique
  senhaHash        String
  perfil           Perfil         @default(FUNCIONARIO)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  dataInicioEscala DateTime?      @map("data_inicio_escala")
  horarioBaseId    String?        @map("horario_base_id")
  
  // 🟢 NOVOS RELACIONAMENTOS OBRIGATÓRIOS DO FUNCIONÁRIO
  empresaId        String          @default("id-empresa-padrao")@map("empresa_id")
  empresa          Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  filialId         String          @default("id-filial-padrao") @map("filial_id")
  filial           Filial          @relation(fields: [filialId], references: [id], onDelete: Cascade)
  setorId          String          @default("id-setor-padrao") @map("setor_id")
  setor            Setor           @relation(fields: [setorId], references: [id], onDelete: Cascade)

  batidas          BatidaPonto[]
  logs             LogAuditoria[]
  Horario          Horario?       @relation(fields: [horarioBaseId], references: [id])
  afastamentos     Afastamento[]

  @@map("usuarios")
}

model Horario {
  id                      String     @id(map: "horarios_pkey") @default(uuid())
  descricao               String
  tipoEscala              TipoEscala @default(SEMANAL) @map("tipo_escala")
  utilizaAlmocoAutomatico Boolean    @default(true) @map("utiliza_almoco_automatico")
  duracaoAlmocoMinutos    Int        @default(60) @map("duracao_almoco_minutos")
  horaEntradaPadrao       String     @default("08:00") @map("hora_entrada_padrao")
  horaSaidaPadrao         String     @default("17:00") @map("hora_saida_padrao")
  trabalhaSabado          Boolean    @default(false) @map("trabalha_sabado")
  horaEntradaSabado       String     @default("08:00") @map("hora_entrada_sabado")
  horaSaidaSabado         String     @default("12:00") @map("hora_saida_sabado")
  trabalhaDomingo         Boolean    @default(false) @map("trabalha_domingo")
  horaEntradaDomingo      String     @default("08:00") @map("hora_entrada_domingo")
  horaSaidaDomingo        String     @default("12:00") @map("hora_saida_domingo")
  trabalhaDomingoAlt      Boolean    @default(false) @map("trabalha_domingo_alt")
  domingoInicioImpar      Boolean    @default(true) @map("domingo_inicio_impar")
  createdAt               DateTime   @default(now()) @map("created_at")
  usuarios                Usuario[]

  // 🔒 ADICIONE ESTAS TRÊS LINHAS PARA O ISOLAMENTO MULTI-TENANT:
  empresaId               String
  empresa                 Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model BatidaPonto {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  dataHora   DateTime @default(now()) @map("data_hora")
  fotoBase64 String   @map("foto_base64")
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now()) @map("created_at")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  // 🟢 NOVOS CAMPOS NA BATIDA (Garante rastreabilidade histórica em auditoria se o funcionário mudar de cargo)
  empresaId  String   @default("id-empresa-padrao") @map("empresa_id")
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  setorId    String   @default("id-setor-padrao") @map("setor_id")
  setor      Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)

  modificacoes HistoricoModificacaoPonto[]

  @@map("batidas_ponto")
}

model HistoricoModificacaoPonto {
  id               String      @id @default(uuid())
  batidaPontoId    String      @map("batida_ponto_id")
  batidaPonto      BatidaPonto @relation(fields: [batidaPontoId], references: [id], onDelete: Cascade)
  dataHoraAnterior DateTime    @map("data_hora_anterior")
  dataHoraNova     DateTime    @map("data_hora_nova")
  justificativa    String
  alteradoPorId    String?     @map("alterado_por_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@map("historico_modificacoes_ponto")
}

model LogAuditoria {
  id              String   @id @default(uuid())
  usuarioAcaoId   String?  @map("usuario_acao_id")
  acao            String
  entidade        String
  dadosAnteriores Json?    @map("dados_anteriores")
  dadosNovos      Json?    @map("dados_novos")
  ipOrigem        String?  @map("ip_origem")
  dataHora        DateTime @default(now()) @map("data_hora")
  usuarioAcao     Usuario? @relation(fields: [usuarioAcaoId], references: [id])

  @@map("logs_auditoria")
}

model Afastamento {
  id            String          @id @default(uuid())
  usuarioId     String          @map("usuario_id")
  usuario       Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo          TipoAfastamento @default(FERIAS)
  dataInicio    DateTime        @map("data_inicio")
  dataFim       DateTime        @map("data_fim")
  justificativa String          @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // 🟢 AFILIAÇÃO MULTI-TENANT NO ABONO
  empresaId     String          @default("id-empresa-padrao") @map("empresa_id")
  empresa       Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("afastamentos")
}

enum Perfil {
  SUPER_ADMIN
  ADMIN
  FUNCIONARIO
}

enum TipoEscala {
  SEMANAL
  ALTERNADA
}

enum TipoAfastamento {
  FERIAS
  ATESTADO_MEDICO
  LICENCA_MATERNIDADE
  LICENCA_PATERNIDADE
  AFASTAMENTO_INSS
  OUTROS
}