{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "rootDir": "./src",                  /* O TypeScript sabe que o código começa em /src */
    "outDir": "./dist",                 /* Ele vai criar os arquivos direto dentro de /dist */
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "dist"]    /* Removemos a menção ao ponto-web */
}